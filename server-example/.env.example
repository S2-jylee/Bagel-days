SQUARE_ACCESS_TOKEN=your_sandbox_or_production_access_token
SQUARE_LOCATION_ID=your_location_id

# Supabase — used to save each paid order (name, phone, items, total) to the
# orders table. Get these from Project Settings -> API in the Supabase
# dashboard. SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security, so it
# must only ever live here (server-side) — never in frontend code.
SUPABASE_URL=https://bpyvdmuzyahweevfrqym.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Twilio — used by /api/reject-order to text a customer when staff reject
# their order. Get these from the Twilio console (console.twilio.com).
# A trial account can only SMS numbers you've manually verified there.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
